{
  "name": "rfm-pwa",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,css}\"",
    "version:check": "node scripts/check-version.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run --coverage",
    "test:coverage": "npm run test:unit",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:chromium": "playwright test --project=chromium",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:pwa": "playwright test -c playwright.pwa.config.js",
    "test:migration": "playwright test -c playwright.migration.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eruda": "^3.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "18.0.1",
    "prettier": "3.6.2",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "2.2.5",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.11.1",
    "pmtiles": "4.5.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
